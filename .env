# Prisma runtime connection (Supabase Session pooler — used by the Next.js app)
# Username format: postgres.[project-ref]  (required by Session pooler)
# Password "Saroj@#2026" URL-encoded → "Saroj%40%232026"
DATABASE_URL="postgresql://postgres.qxpmwnoinjzqhkjhhokz:Saroj%40%232026@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?pgbouncer=true"

# Prisma migration connection (Supabase Session pooler — used by prisma db push)
# Do NOT add ?pgbouncer=true here (Prisma migrations need a direct/pooled conn without pgbouncer flag for schema changes).
DIRECT_URL="postgresql://postgres.qxpmwnoinjzqhkjhhokz:Saroj%40%232026@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase client APIs (optional — only if you add @supabase/supabase-js later)
NEXT_PUBLIC_SUPABASE_URL="https://qxpmwnoinjzqhkjhhokz.supabase.co"
