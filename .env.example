# =============================================================================
# TNL Fincorp - Environment Variables Example
# =============================================================================
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# NEVER commit your real ".env" file. It is git-ignored by default.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma + Supabase PostgreSQL)
#
# The Prisma schema uses the "postgresql" provider. Use your Supabase pooler
# URL for DATABASE_URL (connection pooling) and the direct URL for DIRECT_URL
# (used by prisma db push / migrations).
#
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
#
# Format:
#   DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:5432/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://<user>:<password>@<direct-host>:5432/postgres"
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<direct-host>.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway
# Get your keys from: https://dashboard.razorpay.com/app/keys
# - RAZORPAY_KEY_ID             : Server-side key id (secret)
# - RAZORPAY_KEY_SECRET         : Server-side key secret (secret)
# - NEXT_PUBLIC_RAZORPAY_KEY_ID : Public key id (safe to expose to the browser)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_public_key_id_here"
