// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id           String   @id @default(cuid())
  fullName     String
  mobile       String
  email        String
  loanType     String
  loanAmount   String?
  employment   String?
  city         String?
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OtpRequest {
  id        String   @id @default(cuid())
  mobile    String
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InstantLoanApplication {
  id                     String   @id @default(cuid())
  applicationReference   String   @unique
  fullName               String
  mobileNumber           String
  email                  String
  dateOfBirth            String?
  employmentType         String?
  monthlyIncome          String?
  city                   String?
  state                  String?
  requestedAmount        String?
  category               String
  partnerId              String?
  partnerName            String?
  paymentAmount          Decimal? @db.Decimal(10, 2)
  paymentCurrency        String?  @default("INR")
  paymentStatus          String   @default("pending")
  paymentProvider        String?
  paymentOrderId         String?  @unique
  paymentTransactionId   String?
  paymentVerifiedAt      DateTime?
  verificationStatus     String   @default("pending")
  partnerAccessUnlocked  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([mobileNumber])
  @@index([email])
  @@index([partnerId])
  @@index([paymentStatus])
  @@index([applicationReference])
  @@index([createdAt])
}

model Bonds {
  id                        String   @id @default(cuid())
  applicationNumber         String   @unique
  userId                    String?
  bondId                    String
  status                    String   @default("draft")

  // Applicant Details
  fullName                  String
  fatherHusbandName         String?
  dateOfBirth               String?
  panNumber                 String?
  aadhaarNumber             String?
  mobileNumber              String
  email                     String
  residentialAddress        String?
  city                      String?
  state                     String?
  pinCode                   String?

  // Bond Details
  bondType                  String?
  bondName                  String?
  tenure                    String?
  faceValue                 Decimal? @db.Decimal(12, 2)
  investmentAmount          Decimal? @db.Decimal(12, 2)
  quantity                  Int?
  couponRate                String?
  applicationDate           DateTime?

  // Bank Details
  bankName                  String?
  branch                    String?
  accountNumber             String?
  ifscCode                  String?
  accountType               String?

  // Nominee Details
  nomineeName               String?
  nomineeRelationship       String?
  nomineeDateOfBirth        String?
  nomineeAddress            String?

  // Declaration
  declarationAccepted       Boolean  @default(false)
  declarationAcceptedAt     DateTime?
  place                     String?
  signatureDate             DateTime?

  // Signatures / Documents
  applicantSignature        String?
  jointApplicantSignature   String?
  panDocumentUrl            String?
  addressDocumentUrl        String?
  bankDocumentUrl           String?
  photographUrl             String?
  otherDocumentUrl          String?
  otherDocumentDescription  String?

  // Payment
  paymentStatus             String   @default("pending")
  paymentOrderId            String?  @unique
  paymentTransactionId      String?
  paymentAmount             Decimal? @db.Decimal(10, 2)
  paymentCurrency           String?  @default("INR")
  paymentVerifiedAt         DateTime?

  // Certificate
  certificateNumber         String?  @unique
  certificateIssueDate      DateTime?
  certificateIssued         Boolean  @default(false)
  certificatePdfUrl         String?
  certificateGeneratedAt    DateTime?

  // Administrative / Office Use
  dateReceived              DateTime?
  amountReceived            Decimal? @db.Decimal(10, 2)
  paymentMode               String?
  verifiedBy                String?
  authorizedOfficer         String?
  officialNotes             String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([applicationNumber])
  @@index([userId])
  @@index([bondId])
  @@index([paymentOrderId])
  @@index([paymentTransactionId])
  @@index([createdAt])
}

/// Fixed Deposit application table (exact name "FD")
model FD {
  id                        String   @id @default(cuid())
  applicationNo             String   @unique
  applicationDate           DateTime @default(now())
  userId                    String?

  // Applicant
  applicantName             String
  fatherHusbandName         String?
  dateOfBirth               String?
  gender                    String?
  panNo                     String?
  aadhaarIdNo               String?
  mobile                    String
  email                     String
  residentialAddress        String?
  city                      String?
  state                     String?
  pin                       String?

  // Occupation
  occupation                String?
  employerBusinessName      String?
  annualIncome              String?

  // FD Details
  depositAmount             Decimal? @db.Decimal(12, 2)
  amountInWords             String?
  tenureMonths              Int?
  tenureYears               Int?
  interestRate              Decimal? @db.Decimal(5, 2)
  interestPaymentOption     String?
  depositType               String?
  depositDate               DateTime?
  maturityDate              DateTime?
  maturityAmount            Decimal? @db.Decimal(14, 2)

  // Maturity Instructions
  maturityInstruction       String?
  bankAccountNo             String?
  bankName                  String?
  branch                    String?
  ifscCode                  String?

  // Nominee
  nomineeName               String?
  nomineeRelationship       String?
  nomineeDateOfBirth        String?
  nomineeAddress            String?
  nomineeMobile             String?

  // Joint Applicant
  jointApplicantName        String?
  jointApplicantRelationship String?
  jointApplicantPan         String?
  jointApplicantMobile      String?
  modeOfOperation           String?
  jointApplicantEnabled     Boolean  @default(false)

  // Documents Checklist
  panDocument               Boolean  @default(false)
  aadhaarDocument           Boolean  @default(false)
  addressProofDocument      Boolean  @default(false)
  photographDocument        Boolean  @default(false)
  bankAccountProofDocument  Boolean  @default(false)
  kycDocuments              Boolean  @default(false)
  otherDocuments            String?

  // Declaration / Signature
  declarationAccepted       Boolean  @default(false)
  applicantSignature        String?
  jointApplicantSignature   String?

  // Payment
  paymentStatus             String   @default("pending")
  paymentOrderId            String?  @unique
  paymentTransactionId      String?
  paymentAmount             Decimal? @db.Decimal(10, 2)
  paymentDate               DateTime?
  paymentProviderReference  String?

  // Certificate
  certificateNo             String?  @unique
  fdAccountNo               String?  @unique
  certificateIssueDate      DateTime?
  certificateGenerated      Boolean  @default(false)
  certificateGeneratedAt    DateTime?
  certificatePdfUrl         String?

  // Office / Admin
  customerId                String?
  fdReceiptNo               String?
  kycVerified               String?
  documentsVerifiedBy       String?
  depositReceived           String?
  interestRateApproved      Decimal? @db.Decimal(5, 2)
  authorizedOfficerName     String?
  officerSignature          String?
  officeSeal                String?
  status                    String   @default("draft")

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([applicationNo])
  @@index([userId])
  @@index([mobile])
  @@index([email])
  @@index([paymentOrderId])
  @@index([paymentStatus])
  @@index([fdAccountNo])
  @@index([createdAt])
}

/// Recurring Deposit application table (exact name "RD")
model RD {
  id                        String   @id @default(cuid())
  applicationNo             String   @unique
  applicationDate           DateTime @default(now())
  userId                    String?

  // Applicant
  applicantName             String
  fatherHusbandName         String?
  dateOfBirth               String?
  gender                    String?
  panNo                     String?
  aadhaarIdNo               String?
  mobile                    String
  email                     String
  residentialAddress        String?
  city                      String?
  state                     String?
  pin                       String?

  // Occupation
  occupation                String?
  employerBusinessName      String?
  annualIncome              String?

  // RD Details
  depositAmount             Decimal? @db.Decimal(12, 2)
  amountInWords             String?
  tenureMonths              Int?
  tenureYears               Int?
  interestRate              Decimal? @db.Decimal(5, 2)
  interestPaymentOption     String?
  depositType               String?
  depositDate               DateTime?
  maturityDate              DateTime?
  maturityAmount            Decimal? @db.Decimal(14, 2)

  // Maturity Instructions
  maturityInstruction       String?
  bankAccountNo             String?
  bankName                  String?
  branch                    String?
  ifscCode                  String?

  // Nominee
  nomineeName               String?
  nomineeRelationship       String?
  nomineeDateOfBirth        String?
  nomineeAddress            String?
  nomineeMobile             String?

  // Joint Applicant
  jointApplicantName        String?
  jointApplicantRelationship String?
  jointApplicantPan         String?
  jointApplicantMobile      String?
  modeOfOperation           String?
  jointApplicantEnabled     Boolean  @default(false)

  // Documents Checklist
  panDocument               Boolean  @default(false)
  aadhaarDocument           Boolean  @default(false)
  addressProofDocument      Boolean  @default(false)
  photographDocument        Boolean  @default(false)
  bankAccountProofDocument  Boolean  @default(false)
  kycDocuments              Boolean  @default(false)
  otherDocuments            String?

  // Declaration / Signature
  declarationAccepted       Boolean  @default(false)
  applicantSignature        String?
  jointApplicantSignature   String?

  // Payment
  paymentStatus             String   @default("pending")
  paymentOrderId            String?  @unique
  paymentTransactionId      String?
  paymentAmount             Decimal? @db.Decimal(10, 2)
  paymentDate               DateTime?
  paymentProviderReference  String?

  // Certificate
  certificateNo             String?  @unique
  rdAccountNo               String?  @unique
  certificateIssueDate      DateTime?
  certificateGenerated      Boolean  @default(false)
  certificateGeneratedAt    DateTime?
  certificatePdfUrl         String?

  // Office / Admin
  customerId                String?
  rdReceiptNo               String?
  kycVerified               String?
  documentsVerifiedBy       String?
  depositReceived           String?
  interestRateApproved      Decimal? @db.Decimal(5, 2)
  authorizedOfficerName     String?
  officerSignature          String?
  officeSeal                String?
  status                    String   @default("draft")

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([applicationNo])
  @@index([userId])
  @@index([mobile])
  @@index([email])
  @@index([paymentOrderId])
  @@index([paymentStatus])
  @@index([rdAccountNo])
  @@index([createdAt])
}
